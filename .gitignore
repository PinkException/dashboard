# The real config lives at ~/.claude/my-dashboard/config.json, never in a repo.
# This rule is a safety net in case a copy ever lands here anyway.
dashboard.config.json

# Local Claude Code / jig state (machine-specific, not part of the project).
# Root-anchored so test fixtures may contain .claude/ trees (bug 001).
/.claude/
/.jig/

# macOS Finder artifacts (any directory).
.DS_Store

# Machine-local working notes that must never be committed or shipped — e.g.
# audit evidence naming real surveyed projects. Root-anchored, same as above.
/.private/

# This repo's own runtime snapshot output. Root-anchored so it cannot swallow
# the tracked fixture at test/fixtures/**/docs/status/ (that was bug 001).
# Until now this was only kept out of git by a machine-local global ignore,
# which left a fresh clone, CI, or another machine unprotected.
/docs/status/

# >>> jig secret-ignore >>>
# jig secret-prevention floor (ADR-0013) — git-ignore common secret
# files so they can't be staged by accident. Edit above/below the
# markers; this block is regenerated by jig and re-runs are idempotent.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
secrets/
credentials/
.jig/semantic-index-claude-hook.json
.jig/semantic-index-codex-hook.json
.jig/semantic-index-events.jsonl
.jig/servo-hint-shown
# <<< jig secret-ignore <<<
